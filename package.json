{
  "name": "opencode-goal",
  "version": "0.3.2",
  "description": "Persistent, host-verified goal mode for OpenCode 2 with a structured goal contract and a live TUI.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "opencode": ">=2.0.22"
  },
  "scripts": {
    "test": "bun test --timeout 120000",
    "test:host": "bun test test/host --timeout 120000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode/client": "2.0.22",
    "@opencode/plugin": "2.0.22",
    "@opencode/theme": "2.0.22",
    "@opentui/core": "0.5.14",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./server.ts",
    "./server": "./server.ts",
    "./tui": "./tui.tsx",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "server.ts",
    "tui.tsx",
    "rpc.ts",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kryptobaseddev/opencode-goal.git"
  },
  "homepage": "https://github.com/kryptobaseddev/opencode-goal#readme",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "goal",
    "goal-mode",
    "autonomous",
    "agent"
  ],
  "dependencies": {
    "@opentui/solid": "0.5.14",
    "solid-js": "1.9.15"
  }
}
